{
  "name": "waweb-tams",
  "version": "1.3.0",
  "description": "Ultra-lightweight WhatsApp Web desktop wrapper built with Rust and Tauri v2",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --no-bundle",
    "build:bundle": "tauri build",
    "build:portable": "cargo build --manifest-path src-tauri/Cargo.toml --release",
    "build:portable:linux": "bash scripts/build-release.sh",
    "start": "bash scripts/start-app.sh",
    "clean:linux": "bash scripts/clean.sh",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "lint:all": "npm run fmt:check && npm run lint && npm run check:js",
    "check:js": "node --check src-tauri/assets/enhancements.js",
    "fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "verify:env": "node -e \"const p=process.platform; if(p==='win32'){require('child_process').spawnSync('powershell',['-ExecutionPolicy','Bypass','-File','scripts/verify-env.ps1'],{stdio:'inherit'})}else{require('child_process').spawnSync('bash',['scripts/verify-env.sh'],{stdio:'inherit'})}\"",
    "clean": "cargo clean --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  }
}

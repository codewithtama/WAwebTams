# ==============================================================================
# Enterprise Git Ignore Configuration
# ==============================================================================

# Compiled binaries and executables
*.exe
*.msi
*.dll
*.so
*.dylib
*.pdb

# Rust build artifacts & target directories
target/
src-tauri/target/
.cargo-target/
**/*.rs.bk

# Node.js dependencies & package manager caches
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# OS-specific files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# IDE & Editor configurations
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Temporary & cache files
*.log
*.tmp
*.bak
.cache/
dist/
build/
